DB_URL=jdbc:mysql://hostname:port/database_name?parameters
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

JWT_SECRET=YourSuperSecretKeyForSigningTokensHereMustBeLongEnough

# Optional: a separate test database. When set, these are used instead of DB_* above.
# End the URL with &createDatabaseIfNotExist=true so a wiped database is re-created on startup.
TEST_DB_URL=
TEST_DB_USERNAME=
TEST_DB_PASSWORD=

# Paystack test mode: dashboard.paystack.com > Settings > API Keys & Webhooks > Test Secret Key (starts with sk_test_)
PAYSTACK_SECRET_KEY=

# Email for signup verification codes. Required: signup can't send a code without it.
# Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_USERNAME=your Gmail address,
# MAIL_PASSWORD=a Google "App password" (Google Account > Security > 2-Step Verification > App passwords)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Admin account the backend creates on startup if it doesn't exist yet (email must end with @tekkies.com)
ADMIN_EMAIL=
ADMIN_PASSWORD=
