DB_URL=jdbc:mysql://hostname:port/database_name?parameters
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

JWT_SECRET=YourSuperSecretKeyForSigningTokensHereMustBeLongEnough

# Optional: a separate test database. When set, these are used instead of DB_* above.
TEST_DB_URL=
TEST_DB_USERNAME=
TEST_DB_PASSWORD=

# Paystack test mode: dashboard.paystack.com > Settings > API Keys & Webhooks > Test Secret Key (starts with sk_test_)
PAYSTACK_SECRET_KEY=
